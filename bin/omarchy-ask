#!/usr/bin/env bash
# Ask Claude about this Omarchy machine — keybindings, config, commands.
#
#   omarchy-ask "how do I move a window to workspace 3"
#   omarchy-ask --stream [--session UUID] "..."   # claude stream-json on stdout
#   omarchy-ask context [--rebuild]               # regenerate the machine context
#   omarchy-ask docs --refresh                    # re-scrape omarchy.org/manual
#   omarchy-ask teach --right "..." [--question "..."] [--wrong "..."]
#   omarchy-ask expertise                         # print the corrections file path
#   omarchy-ask review --question "..." --answer "..."   # hand it to an interactive
#                                                 # claude for a second opinion
#
# The context bundle is assembled from live hyprctl state plus this machine's
# config; the manual and the omarchy sources stay on disk and are grepped by
# the model only when a question needs them.

set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/ask"
CONTEXT="$STATE/context.md"
SYSPROMPT="$STATE/system-prompt.md"
EXPERTISE="$STATE/expertise.md"
DOCS="$STATE/docs"
OMARCHY_SHARE="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
HYPR_DIR="$HOME/.config/hypr"
OMARCHY_CONF="$HOME/.config/omarchy"
MODEL="${OMARCHY_ASK_MODEL:-sonnet}"
# The reviewer should not be the model that produced the answer.
REVIEW_MODEL="${OMARCHY_ASK_REVIEW_MODEL:-opus}"
EFFORT="${OMARCHY_ASK_EFFORT:-low}"
DOCS_MAX_AGE_DAYS="${OMARCHY_ASK_DOCS_MAX_AGE:-30}"

# mise prints a tools banner on stdout, which would land in the middle of the
# JSON stream the widget parses.
export MISE_QUIET=1

mkdir -p "$STATE" "$DOCS"

die() { echo "omarchy-ask: $*" >&2; exit 1; }

# ---------------------------------------------------------------- context

# Omarchy declares every bind in Lua, so `hyprctl binds` reports dispatcher
# "__lua" and leaves .key empty for keycode binds (the workspace numbers among
# them). The Lua sources are therefore the primary record and hyprctl is the
# cross-check for anything bound outside them.
lua_binds() {
  local files=("$OMARCHY_SHARE"/default/hypr/bindings/*.lua "$OMARCHY_SHARE"/default/hypr/*.lua "$HYPR_DIR"/*.lua)
  # The example bindings shipped in bindings.lua are commented out, and a
  # commented bind read as a real one is worse than no answer at all.
  grep -h -vE '^[[:space:]]*--' "${files[@]}" 2>/dev/null |
    grep -oE '(o\.bind|hl\.unbind)\("[^"]*"(, *(nil|"[^"]*"))?' |
    sed -E 's/^o\.bind\("([^"]*)", *"([^"]*)".*/\1 → \2/;
            s/^o\.bind\("([^"]*)", *nil.*/\1 → (no description)/;
            s/^o\.bind\("([^"]*)".*/\1 → (no description)/;
            s/^hl\.unbind\("([^"]*)".*/\1 → UNBOUND/' |
    # code:10..19 are the number row; nobody types "code:12".
    awk '{ for (i = 10; i <= 19; i++) { n = (i == 19 ? 0 : i - 9); gsub("code:" i "( |$)", n " ") } sub(/ +→/, " →"); print }' |
    sort -u
}

hyprctl_binds() {
  command -v hyprctl >/dev/null || { echo "(hyprctl unavailable — Hyprland not running)"; return; }
  hyprctl binds -j 2>/dev/null | jq -r '
    def bit($v): ((.modmask / $v) | floor) % 2 == 1;
    def mod($v; $n): if bit($v) then [$n] else [] end;
    # Binds generated by a Lua loop arrive with an empty .key. The number-row
    # ones name their workspace in the description and are bound to that digit,
    # so recover it there rather than printing a bind nobody can press.
    def keyname:
      if .key != "" then .key
      elif (.description | test("workspace ([1-9]|10)$"))
        then (.description | capture("workspace (?<n>[1-9]|10)$").n | if . == "10" then "0" else . end)
      else "?(declared in Lua)" end;
    .[]
    | (mod(64; "SUPER") + mod(4; "CTRL") + mod(8; "ALT") + mod(1; "SHIFT") + [keyname] | join(" + ")) as $combo
    | (if .description != "" then .description else (.dispatcher + " " + (.arg // "")) end) as $action
    | (if .submap != "" then "[submap:" + .submap + "] " else "" end) + $combo + " → " + $action
  ' | sort -u
}

# Omarchy's bind files are Lua, and the dispatcher surface is provided by
# Hyprland itself rather than by any file on disk — so without this the model
# has nothing to check a helper name against and will invent one that does not
# exist. Asking the running compositor is the only source of truth.
lua_api() {
  command -v hyprctl >/dev/null || return 0
  local out="$STATE/hl-dsp.txt"
  hyprctl eval "local f = io.open('$out', 'w') if not f then return end local function dump(t, prefix) local keys = {} for k in pairs(t) do keys[#keys+1] = k end table.sort(keys) for _, k in ipairs(keys) do local v = t[k] if type(v) == 'table' then dump(v, prefix .. k .. '.') else f:write(prefix .. k .. '\n') end end end dump(hl.dsp, 'hl.dsp.') f:close()" >/dev/null 2>&1
  # hyprctl returns as soon as the compositor accepts the snippet, not when the
  # Lua has finished writing, so give the file a moment before reading it. A
  # previous dump is used if this one is slow — the API does not change often.
  local i
  for i in 1 2 3 4 5; do [ -s "$out" ] && break; sleep 0.2; done

  if [ -s "$out" ]; then
    echo "These are the ONLY dispatchers that exist. Anything not listed here is not real."
    echo
    tr '\n' ' ' < "$out"
    echo
  fi
}

dump_files() {
  local f
  for f in "$@"; do
    [ -r "$f" ] || continue
    printf '\n### %s\n```\n' "$f"
    cat "$f"
    printf '```\n'
  done
}

build_context() {
  local version="unknown"
  [ -r "$OMARCHY_SHARE/version" ] && version=$(<"$OMARCHY_SHARE/version")

  {
    echo "# This machine"
    echo
    echo "Host: $(hostname). Omarchy version: $version. Hyprland: $(hyprctl version 2>/dev/null | head -1 || echo unknown)"
    echo
    echo "## Keybindings — declared in Lua (authoritative, includes this machine's overrides)"
    echo
    echo '```'
    lua_binds
    echo '```'
    echo
    echo "## Keybindings — as Hyprland reports them right now (cross-check)"
    echo
    echo '```'
    hyprctl_binds
    echo '```'
    echo
    echo "## Hyprland config on this machine"
    dump_files "$HYPR_DIR"/*.conf "$HYPR_DIR"/*.lua
    echo
    echo "## Hyprland Lua dispatcher API — what bindings.lua can call"
    echo
    echo '```'
    lua_api
    echo '```'
    echo
    echo "## Omarchy shell / bar config"
    dump_files "$OMARCHY_CONF/shell.json"
    echo
    echo "## omarchy-* commands installed"
    echo
    echo '```'
    ls "$OMARCHY_SHARE/bin" 2>/dev/null | paste -sd' ' - | fold -s -w 100
    echo '```'
  } > "$CONTEXT.tmp"
  mv "$CONTEXT.tmp" "$CONTEXT"
}

# Rebuild when anything the bundle is made of is newer than the bundle itself.
context_is_stale() {
  [ -f "$CONTEXT" ] || return 0
  local newer
  newer=$(find "$HYPR_DIR" "$OMARCHY_CONF/shell.json" -maxdepth 1 -newer "$CONTEXT" -print -quit 2>/dev/null || true)
  [ -n "$newer" ]
}

ensure_context() {
  if [ "${1:-}" = "--rebuild" ] || context_is_stale; then build_context; fi
}

write_system_prompt() {
  cat > "$SYSPROMPT" <<'PROMPT'
You are the Omarchy expert for this specific machine: Arch Linux running
Hyprland under Omarchy, with the Omarchy quickshell bar.

A CORRECTIONS section in the user message, when present, is the user correcting
an earlier wrong answer. It outranks everything else, including the live bind
table. Follow it, and never argue with it.

The MACHINE CONTEXT in the user message is authoritative for what is actually
configured here. The live `hyprctl binds` table outranks any conf file it
disagrees with. Never answer from generic Hyprland knowledge when the context
covers the question.

When the context is not enough, read what you need from these directories
before answering:
  ~/.local/state/omarchy/ask/docs       the omarchy.org manual, one file per page
  ~/.local/share/omarchy                omarchy's own scripts, defaults, shell source
  ~/.config/hypr  ~/.config/omarchy     this machine's config

Answer format, strictly:
- First line: the direct answer and nothing else. For a keybinding that is the
  combo alone, e.g. `SUPER + SHIFT + 3`. For a command, the command line.
- Then at most three short lines of detail, only if they change what the user does.
- Last line: `source: <path>` or `source: <command>`. One source.
- No preamble, no restating the question, no headers, no bullet lists, no
  closing offer of further help.

Write keybindings as SUPER + SHIFT + K, in that modifier order.

When you write a binding, use only dispatchers from the Lua dispatcher API
section. Never invent an `hl.dsp.*` name that is not listed there; if what the
user wants has no dispatcher, say so rather than guessing at one.

If something is not configured on this machine, say so in the first line and
give the smallest change that would configure it.
PROMPT
}

# ------------------------------------------------------------------ docs

refresh_docs() {
  command -v claude >/dev/null || die "claude CLI not found"
  echo "omarchy-ask: scraping https://omarchy.org/manual/ into $DOCS" >&2
  claude -p "Map https://omarchy.org/manual/ with firecrawl_map, then scrape every
manual page with firecrawl_scrape in markdown format. Write one file per page into
$DOCS, named after the page slug with a .md extension, each starting with a line
'source: <url>'. Delete nothing else in that directory. Report only the number of
pages written." \
    --model sonnet \
    --allowed-tools "mcp__firecrawl-mcp__firecrawl_map mcp__firecrawl-mcp__firecrawl_scrape Write Bash(ls:*)" \
    --add-dir "$DOCS" \
    --setting-sources user \
    --output-format text >&2
  echo "omarchy-ask: docs refreshed" >&2
}

docs_note() {
  local newest
  newest=$(find "$DOCS" -name '*.md' -mtime "-$DOCS_MAX_AGE_DAYS" -print -quit 2>/dev/null || true)
  if [ -z "$(ls -A "$DOCS" 2>/dev/null)" ]; then
    echo "(The manual cache is empty. Run: omarchy-ask docs --refresh)"
  elif [ -z "$newest" ]; then
    echo "(The manual cache is older than $DOCS_MAX_AGE_DAYS days.)"
  fi
}

# ------------------------------------------------------------- expertise

# Corrections are the one part of the context a person writes by hand, so they
# are kept as plain readable markdown rather than a record format: the file is
# meant to be opened and edited when an entry stops being true.
teach() {
  local question="$1" wrong="$2" right="$3"
  [ -n "$right" ] || die "teach needs --right"

  if [ ! -f "$EXPERTISE" ]; then
    cat > "$EXPERTISE" <<'HEADER'
# Corrections

Written by hand, or by the Teach button in the bar widget. Every entry here
outranks the machine context and the manual — this is where you record what
Claude got wrong about this machine, and what is actually true.

Edit or delete an entry when it stops being true. Nothing prunes this file.

HEADER
  fi

  {
    printf '## %s' "$(date +%Y-%m-%d)"
    [ -n "$question" ] && printf ' · %s' "$question"
    printf '\n'
    [ -n "$wrong" ] && printf -- '- Claude said: %s\n' "$wrong"
    printf -- '- Correct: %s\n\n' "$right"
  } >> "$EXPERTISE"

  echo "omarchy-ask: recorded in $EXPERTISE" >&2
}

expertise_section() {
  [ -s "$EXPERTISE" ] || return 0
  printf '# CORRECTIONS — authoritative, they outrank everything below\n\n%s\n' "$(cat "$EXPERTISE")"
}

# -------------------------------------------------------------- review

# A second opinion is worth having only if it is genuinely independent: this
# starts a fresh interactive Claude in a terminal, points it at the primary
# sources, and explicitly tells it not to trust the context bundle that
# produced the answer under review. It can record its own correction, which is
# what closes the loop back into the widget.
review() {
  local question="$1" answer="$2"
  [ -n "$question" ] || die "review needs --question"
  command -v claude >/dev/null || die "claude CLI not found"

  local primer
  primer=$(cat <<PRIMER
You are giving a second opinion on an answer about this Omarchy machine
(Arch Linux, Hyprland, the Omarchy quickshell bar). The answer came from the
"Ask Omarchy" bar widget and may be wrong.

QUESTION ASKED
$question

ANSWER GIVEN
$answer

Check it against primary sources before you agree with any of it:
- the live compositor: hyprctl binds -j, hyprctl clients -j, and hyprctl eval
  for the Lua API surface
- this machine's config: ~/.config/hypr/*.lua, ~/.config/hypr/*.conf,
  ~/.config/omarchy/shell.json
- Omarchy itself: /usr/share/omarchy/default/ and /usr/share/omarchy/bin/
- the manual: ~/.local/state/omarchy/ask/docs/

Do not treat ~/.local/state/omarchy/ask/context.md as evidence. That file is
what produced the answer above, so agreeing with it proves nothing. Where you
can test a claim rather than read it — a dispatcher, a command, a bind — test
it.

Then say plainly whether the answer is right, partly right, or wrong, and what
the correct answer is.

If it was wrong or incomplete, record the fix so the widget stops repeating it:

  omarchy-ask teach --question "$question" --wrong "<the wrong claim>" --right "<what is true>"
PRIMER
)

  exec claude --model "$REVIEW_MODEL" "$primer"
}

# ----------------------------------------------------------------- query

STREAM=0
SESSION=""
STUB=0
ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    context)   shift; ensure_context "${1:---rebuild}"; echo "$CONTEXT"; exit 0 ;;
    docs)      shift; [ "${1:-}" = "--refresh" ] || die "usage: omarchy-ask docs --refresh"; refresh_docs; exit 0 ;;
    expertise) echo "$EXPERTISE"; exit 0 ;;
    review)
      shift
      REVIEW_Q=""; REVIEW_A=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --question) REVIEW_Q="${2:-}"; shift 2 ;;
          --answer)   REVIEW_A="${2:-}"; shift 2 ;;
          --model)    REVIEW_MODEL="${2:-}"; shift 2 ;;
          *)          die "unknown review option $1" ;;
        esac
      done
      review "$REVIEW_Q" "$REVIEW_A" ;;
    teach)
      shift
      TEACH_Q=""; TEACH_WRONG=""; TEACH_RIGHT=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --question) TEACH_Q="${2:-}"; shift 2 ;;
          --wrong)    TEACH_WRONG="${2:-}"; shift 2 ;;
          --right)    TEACH_RIGHT="${2:-}"; shift 2 ;;
          *)          die "unknown teach option $1" ;;
        esac
      done
      teach "$TEACH_Q" "$TEACH_WRONG" "$TEACH_RIGHT"
      exit 0 ;;
    --stream)  STREAM=1; shift ;;
    --stub)    STUB=1; shift ;;
    --session) SESSION="${2:-}"; shift 2 ;;
    --model)   MODEL="${2:-}"; shift 2 ;;
    --)        shift; ARGS+=("$@"); break ;;
    -*)        die "unknown option $1" ;;
    *)         ARGS+=("$1"); shift ;;
  esac
done

QUESTION="${ARGS[*]:-}"
[ -n "$QUESTION" ] || die "ask a question"

# The stub exists so the bar widget's focus, streaming, and key handling can be
# exercised without spending a real turn on every reload.
if [ "$STUB" = 1 ]; then
  sid="${SESSION:-00000000-0000-0000-0000-000000000000}"
  if [ "$STREAM" = 1 ]; then
    printf '{"type":"system","subtype":"init","session_id":"%s"}\n' "$sid"
    for word in "SUPER + SHIFT + 3" "" "(stubbed answer to:" "$QUESTION)" "" "source: stub"; do
      printf '{"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":%s}}}\n' \
        "$(jq -Rn --arg w "$word " '$w')"
      sleep 0.15
    done
    printf '{"type":"result","subtype":"success","session_id":"%s","result":"stub"}\n' "$sid"
  else
    echo "SUPER + SHIFT + 3"
    echo "(stubbed answer to: $QUESTION)"
    echo "source: stub"
  fi
  exit 0
fi

command -v claude >/dev/null || die "claude CLI not found"
ensure_context
write_system_prompt

PROMPT_TEXT=$(printf '%s\n\n---\n\n%s\n\n# MACHINE CONTEXT\n\n%s\n\n%s\n' \
  "$QUESTION" "$(expertise_section)" "$(cat "$CONTEXT")" "$(docs_note)")

# A follow-up resumes the same session; a fresh question mints its own id so the
# caller can follow up on it later.
if [ -n "$SESSION" ]; then
  SESSION_ARGS=(--resume "$SESSION")
  # Resumed turns already carry the context from the first message.
  PROMPT_TEXT="$QUESTION"
else
  SESSION=$(uuidgen)
  SESSION_ARGS=(--session-id "$SESSION")
fi

CLAUDE_ARGS=(
  -p
  --model "$MODEL"
  --effort "$EFFORT"
  --system-prompt "$(cat "$SYSPROMPT")"
  --add-dir "$DOCS" --add-dir "$OMARCHY_SHARE" --add-dir "$HYPR_DIR" --add-dir "$OMARCHY_CONF"
  --allowed-tools "Read Grep Glob"
  --strict-mcp-config
  --setting-sources project
  "${SESSION_ARGS[@]}"
)

cd "$STATE"

if [ "$STREAM" = 1 ]; then
  # The widget reads one JSON object per line; anything that is not JSON is a
  # tool banner and must not reach it.
  claude "${CLAUDE_ARGS[@]}" --output-format stream-json --include-partial-messages --verbose "$PROMPT_TEXT" \
    | grep '^{'
else
  echo "session: $SESSION" >&2
  claude "${CLAUDE_ARGS[@]}" --output-format text "$PROMPT_TEXT"
fi
